# Template for .env (which is git-ignored). Copy to .env and edit the paths for your machine.

# Directory vars
FILE_SHARE="C:\path\to\NFF5_Generated_Data"
INPUT_DIR="PR2_POC\01_MultiPosition_FEM"
OUTPUT_DIR="PR2_POC\03_Optimization"
# Local SimNIBS Ernie subject folder (m2m_ernie)
HEAD_DIR="C:\path\to\simnibs4_examples\m2m_ernie"

# Coil FEM meshes, relative to FILE_SHARE\INPUT_DIR
P1_MSH="NFF5_PR2_C20_P1_E_v01.msh"
P2_MSH="NFF5_PR2_C20_P2_E_v01.msh"
P3_MSH="NFF5_PR2_C20_P3_E_v01.msh"

# Output file stem; writes <stem>.csv, <stem>.json and <stem>.png to FILE_SHARE\OUTPUT_DIR
OUTPUT_STEM="PR2_3Coil_Opti_v01"

# Target ROI
TARGET_MNI="-38,44,26"
ROI_RADIUS_MM=10
# SimNIBS tissue tags: gray matter and scalp (surface proxy)
GM_TAG=2
SCALP_TAG=5

# Coil drive, as relative scaling of the reference dI/dt (not amperes)
REFERENCE_DIDT_A_PER_S=1.5e8
COIL_MIN=0
COIL_MAX=1
# Shared normalized drive budget; exploratory, not a hardware rating
MAX_SUM=1.5
BASELINE_WEIGHTS="0.5,0.5,0.5"
# Surface cap relative to the equal-weight baseline; exploratory
SURFACE_LIMIT_RATIO=1.10
OFFTARGET_PENALTY=0.20

# Differential evolution optimizer
SEED=488
DE_POPSIZE=12
DE_MAXITER=120
DE_TOL=1e-7
